# Backend settings. Every value here is optional; the defaults work for local development.
# Set them in your shell before starting the API and the worker, for example:
#   export REDIS_URL="redis://localhost:6379/0"

# Redis connection used for the job store, the result cache, and the RQ job queue.
# Format: redis://[:password@]host:port/db
REDIS_URL="redis://localhost:6379/0"
